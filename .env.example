# 复制为 .env 后按需修改
NODE_ENV=production
PORT=3100
HOST=127.0.0.1                 # 生产环境放在 nginx 后面，只监听本机
TZ=Asia/Shanghai               # 门店本地时区
DB_FILE=./data/barber.db
APP_SECRET=请改成一段随机长字符串   # 用于验证码哈希，openssl rand -hex 32
SMS_PROVIDER=mock              # mock | tencent（需实现/配置，见 README）
PAY_PROVIDER=mock              # mock | wechat（需商户号与证书，见 README）
DEV_SHOW_SMS_CODE=1            # 1=接口返回验证码并在页面显示（仅开发/演示！上线必须设为 0）
DEMO_MODE=1                    # 1=允许店主「重置演示数据」（上线设为 0）
DEMO_OWNER_PASSWORD=mubai2026  # 首次启动时创建的演示账号密码（上线请改）
DEMO_STAFF_PASSWORD=staff2026
PAY_HOLD_MIN=10                # 待支付定金时段保留分钟
SCHEDULER_MS=30000             # 定时任务间隔（过期/自动爽约）
SMS_PER_IP_HOUR=30
LOG_LEVEL=info
